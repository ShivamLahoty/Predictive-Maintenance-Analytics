		dataType: double
		lineageTag: 56e213bc-6189-4e04-83c6-9f5fed490732
		summarizeBy: sum
		sourceColumn: Temp_Diff_K

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

